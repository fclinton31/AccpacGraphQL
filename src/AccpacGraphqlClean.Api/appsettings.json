{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "HotChocolate": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs\\accpacgraphqlclean-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AccpacGraphqlClean",
    "Audience": "AccpacGraphqlClean",
    "SigningKey": "REPLACE_ME_WITH_A_LONG_RANDOM_SECRET_32+",
    "ExpiresInSeconds": 86400
  },
  "ConnectionStrings": {
    "SettingsDb": "Data Source=D:\\Dump\\sagesettings\\SettingsDB.db"
  },
  "Sage300": {
    "ComSessionProgId": "Accpac.Session,ACCPAC.xapiSession",
    "AppId": "XX",
    "AppVersion": "69A",
    "DbLinkTypeCompany": 1,
    "DbLinkFlagsReadWrite": 2
  }
}
